# Copy to `.env` for local dev, and set the same values in the Netlify UI.
# `.env` is gitignored. Never put a key in any VITE_-prefixed variable that
# isn't meant to be public — Vite inlines those into the client bundle.

# ── Client-side (public by design) ───────────────────────────────────────────
# The anon key is safe to ship: RLS in supabase/schema.sql is what protects the
# data, and no policy is granted to `anon`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-side only (Netlify Functions) ─────────────────────────────────────
# These must NOT be prefixed with VITE_. They are read in netlify/functions/ai.ts
# and never reach the browser.
GEMINI_API_KEY=
GROQ_API_KEY=
