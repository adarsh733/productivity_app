    { "id": "pr-debt", "type": "pronounce", "lang": "en", "tags": ["money"], "term": "debt", "syllables": "DET", "stressIndex": 0, "commonError": "The 'b' is silent. It rhymes with 'bet'." },
    { "id": "pr-doubt", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "doubt", "syllables": "DOWT", "stressIndex": 0, "commonError": "The 'b' is silent. It rhymes with 'out'." },
    { "id": "pr-island", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "island", "syllables": "EYE·land", "stressIndex": 0, "commonError": "The 's' is silent." },
    { "id": "pr-iron", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "iron", "syllables": "EYE·urn", "stressIndex": 0, "commonError": "The 'r' moves: it sounds like 'eye-urn', not 'eye-ron'." },
    { "id": "pr-salmon", "type": "pronounce", "lang": "en", "tags": ["food"], "term": "salmon", "syllables": "SAM·un", "stressIndex": 0, "commonError": "The 'l' is silent." },
    { "id": "pr-almond", "type": "pronounce", "lang": "en", "tags": ["food"], "term": "almond", "syllables": "AH·mund", "stressIndex": 0, "commonError": "The 'l' is usually silent." },
    { "id": "pr-hierarchy", "type": "pronounce", "lang": "en", "tags": ["work", "stress"], "term": "hierarchy", "syllables": "HY·uh·rar·ky", "stressIndex": 0, "commonError": "Four syllables, stress on the first. Not 'high-archy'." },
    { "id": "pr-height", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "height", "syllables": "HYT", "stressIndex": 0, "commonError": "Rhymes with 'light'. There is no 'th' sound at the end — not 'heighth'." },
