    { "id": "pr-temperature", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "temperature", "syllables": "TEM·pra·cher", "stressIndex": 0, "commonError": "Three syllables in normal speech, not four. The second 'e' disappears." },
