    { "id": "pr-niche", "type": "pronounce", "lang": "en", "tags": ["work", "borrowed"], "term": "niche", "syllables": "NEESH", "stressIndex": 0, "commonError": "One syllable, ending in 'sh'. Not 'nitch'." },
    { "id": "pr-debut", "type": "pronounce", "lang": "en", "tags": ["borrowed"], "term": "debut", "syllables": "DAY·byoo", "stressIndex": 0, "commonError": "The 't' is silent." },
    { "id": "pr-colleague", "type": "pronounce", "lang": "en", "tags": ["work"], "term": "colleague", "syllables": "KOL·eeg", "stressIndex": 0, "commonError": "Two syllables, stress on the first. Not col-LEEG." },
    { "id": "pr-photographer", "type": "pronounce", "lang": "en", "tags": ["stress"], "term": "photographer", "syllables": "fuh·TOG·ra·fer", "stressIndex": 1, "commonError": "The stress moves with the ending: PHO-to-graph, but pho-TOG-ra-pher. Say all three aloud in a row." }
