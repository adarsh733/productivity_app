    { "id": "pr-chocolate", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "chocolate", "syllables": "CHOK·lit", "stressIndex": 0, "commonError": "Two syllables, not three. The middle 'o' is silent in speech." },
    { "id": "pr-business", "type": "pronounce", "lang": "en", "tags": ["work"], "term": "business", "syllables": "BIZ·nis", "stressIndex": 0, "commonError": "Two syllables. Not 'busy-ness'." },
    { "id": "pr-medicine", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "medicine", "syllables": "MED·sin", "stressIndex": 0, "commonError": "Two syllables in British and Indian English. Not me-di-CINE." },
    { "id": "pr-interesting", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "interesting", "syllables": "IN·tres·ting", "stressIndex": 0, "commonError": "Three syllables. Stress the first and drop the second 'e' entirely." },
