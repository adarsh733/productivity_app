    { "id": "pr-library", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "library", "syllables": "LY·bra·ry", "stressIndex": 0, "commonError": "Both 'r's are pronounced. Not 'ly-bry'." },
    { "id": "pr-february", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "February", "syllables": "FEB·roo·ry", "stressIndex": 0, "commonError": "Stress the first syllable. The first 'r' is often softened in speech." },
    { "id": "pr-wednesday", "type": "pronounce", "lang": "en", "tags": ["everyday"], "term": "Wednesday", "syllables": "WENZ·day", "stressIndex": 0, "commonError": "Two syllables. The 'd' in the middle is silent." },
